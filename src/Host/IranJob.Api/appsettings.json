{
  "Application": {
    "Name": "IranJob",
    "Version": "0.1.0"
  },
      "Database": {
    "ConnectionStringName": "DefaultConnection",
    "ApplyMigrationsOnStartup": true
  },
  "FileStorage": {
    "CvMaxFileSizeBytes": 5242880,
    "AllowedCvExtensions": [ ".pdf", ".doc", ".docx" ],
    "AllowedCvContentTypes": [
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    ],
    "CvStoragePath": "cv-storage"
  },
  // Outbound email is opt-in. Leave Enabled=false (the default) and the email
  // service no-ops, so local dev and tests run without an SMTP server. Set
  // Enabled=true and fill in the SMTP settings below to deliver real email.
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": false,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromDisplayName": "IranJob"
  },
  "ConnectionStrings": {
    //"DefaultConnection": "Server=localhost,1433;Database=IranJob;User Id=sa;Password=Your_strong_Password123;TrustServerCertificate=True;Encrypt=False",
    "DefaultConnection": "Data Source=192.168.13.122;Initial Catalog =Karyabi;User Id=sa;Password=123456;TrustServerCertificate=True;",
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "IranJob",
      "Audience": "IranJob.Client",
      "SecretKey": "DEV_ONLY_CHANGE_ME_use_user_secrets_in_real_dev",
      "AccessTokenExpirationMinutes": 15
    },
    "Identity": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15,
      "RefreshTokenExpirationDays": 7,
      "RefreshTokenCookieName": "iranjob_refresh_token",
      "CsrfCookieName": "iranjob_csrf",
      "CsrfHeaderName": "X-CSRF-TOKEN"
    },
    "RateLimiting": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
